# ─────────────────────────────────────────────────────────────────────
# GeneClarity backend (Supabase) — local configuration
#
# Copy this file to `.env.local` and fill in the two values from your
# Supabase project:
#   Supabase Dashboard → Project Settings → API
#
#   VITE_SUPABASE_URL        e.g. https://abcdefgh.supabase.co
#   VITE_SUPABASE_ANON_KEY   the "anon" / public API key
#
# The app runs in DEMO MODE (localStorage only) when these are absent,
# so nothing breaks before the backend is configured.
#
# `.env.local` is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
